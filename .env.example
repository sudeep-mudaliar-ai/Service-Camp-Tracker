# ============================================================
# Service Camp Tracker - Environment Configuration
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real .env file to version control.
# ============================================================

# ---------- ServiceNow API (Basic Auth) ----------
SERVICENOW_BASE_URL=https://johndeere.service-now.com
SERVICENOW_API_USERNAME=your_servicenow_username_here
SERVICENOW_API_PASSWORD=your_servicenow_password_here

# ---------- Excel storage (OneDrive synced folder) ----------
# Point this at a path INSIDE your local OneDrive folder so the
# OneDrive client syncs the workbook to the cloud automatically.
# Windows example:
ONEDRIVE_EXCEL_PATH=C:/Users/username/OneDrive/AssetEntries.xlsx

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# URL the Streamlit frontend uses to reach the FastAPI backend
BACKEND_BASE_URL=http://127.0.0.1:8000

# ---------- HTTP behaviour ----------
# Seconds before an outbound ServiceNow API call times out
API_TIMEOUT_SECONDS=10
# Number of retry attempts for failed ServiceNow API calls
API_MAX_RETRIES=3

# ---------- Logging ----------
LOG_LEVEL=INFO
